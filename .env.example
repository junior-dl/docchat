# Neon (pgvector) — project "rag-chatbot"
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Your default Gemini key (limited usage for visitors without their own key)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (comma-separated)
GEMINI_CHAT_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Shared secret the n8n cleanup workflow sends in the x-cron-secret header
CRON_SECRET=change-me
